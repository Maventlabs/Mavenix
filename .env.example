# ============================================
# Mavenix — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file to Git!
# ============================================

# ────────────────────────────────────────────
# MODEL GATEWAY (REQUIRED)
# Point this at any OpenAI-compatible endpoint — a hosted API,
# a local model server, or a routing layer like 9Router that
# lets you combine multiple providers with automatic fallback.
# ────────────────────────────────────────────
MODEL_GATEWAY_BASE_URL=http://host.docker.internal:20128/v1
MODEL_GATEWAY_API_KEY=your_api_key_here

# MODEL_ID is REQUIRED — this is the exact model/combo name your
# gateway expects in the "model" field of each request. If you're
# using a router (9Router, OpenRouter, LiteLLM, etc.), this is
# usually the combo/alias name you configured there, not a raw
# provider model name.
MODEL_ID=your-model-or-combo-name

# ────────────────────────────────────────────
# MESSAGING PLATFORMS (choose one or more — all optional except
# whichever one you actually pair during onboarding)
# ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# Discord: create an app at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# WhatsApp: typically via a bridge (e.g. Baileys/whatsapp-web.js-based
# plugin) — check current OpenClaw plugin docs for the exact setup,
# as WhatsApp integration methods change often due to platform policy.
WHATSAPP_SESSION_PATH=

# Slack: create an app at https://api.slack.com/apps
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# ────────────────────────────────────────────
# GATEWAY ACCESS (generated during `openclaw onboard`)
# ────────────────────────────────────────────
GATEWAY_TOKEN=

# ────────────────────────────────────────────
# SEARCH PROVIDER (optional — DuckDuckGo works with no key)
# ────────────────────────────────────────────
# BRAVE_SEARCH_API_KEY=
# EXA_API_KEY=
# TAVILY_API_KEY=

# ────────────────────────────────────────────
# ADDITIONAL MODEL PROVIDERS (all optional)
# Only needed if you're NOT routing everything through a single
# gateway above, or if your router needs these set as environment
# variables to authenticate upstream providers on its own side.
# ────────────────────────────────────────────
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# XAI_API_KEY=

# ────────────────────────────────────────────
# SKILLS (optional — for skills.sh integration, see README)
# ────────────────────────────────────────────
# SKILLS_DIR=/opt/access/skills
